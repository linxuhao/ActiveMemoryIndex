# AML Cycle 2 academic profile, release candidate academic-v4-20261006-rc5.
# rc5 rule: no language-dependent regex or word list decides anything; gpt-4o-mini reads
# language (the as-of classifier and time reader, the update router and stage-2 tags).
# Copy to .env.academic (never commit credentials).
# Use a new store: old BGE vectors cannot be reused with text-embedding-v4.
# AMI_ENV_FILE=.env.academic docker compose --env-file .env.academic -p ami-academic up -d --build

OPENAI_API_KEY=
AMI_LLM_MODEL=gpt-4o-mini
AMI_LLM_CONCURRENCY=8
AMI_AUTH_SCHEME=bearer
AMI_AUTH_TOKEN=

AMI_EMBED_BACKEND=openai
AMI_EMBED_MODEL=text-embedding-v4
# Singapore endpoint; change explicitly if your DashScope key belongs to another region.
AMI_EMBED_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AMI_EMBED_API_KEY=
AMI_EMBED_DIMENSIONS=1024
AMI_EMBED_BATCH=10
# rc4: 40 s per attempt, one retry, 16 provider requests in flight; every attempt is clipped
# to the request deadline below.
AMI_EMBED_TIMEOUT=40
AMI_EMBED_RETRIES=1
AMI_EMBED_CONCURRENCY=16

AMI_CONTAINER=activememoryindex-academic-v4
AMI_IMAGE=activememoryindex:academic-v4-20261006-rc5
AMI_VOLUME=ami-academic-v4-data
AMI_DB_PATH=/data/memory-v4.sqlite3
AMI_BIND=127.0.0.1
AMI_PORT=8012
# Connect the actual proxy network only when publishing this tested candidate.
# AMI_EDGE_NETWORK=cloudflare_edge

AMI_EXTRACT=1
AMI_RECALL_QUERY=1
AMI_RECALL_WEIGHT=0.5
AMI_RETURN_LIMIT=100
AMI_RETURN_CHAR_BUDGET=400000
AMI_RAW_FIRST=1
AMI_WINDOW_RADIUS=1
# Token-aware return budget (rc4, always on): the returned memories never exceed
# (ANSWER_INPUT_TOKENS - ANSWER_PROMPT_TOKENS) / TOKEN_SAFETY - tokens(query + options),
# each memory costing its tokens + ANSWER_ITEM_TOKENS (tiktoken o200k_base).
AMI_ANSWER_INPUT_TOKENS=117760
AMI_ANSWER_PROMPT_TOKENS=1024
AMI_ANSWER_ITEM_TOKENS=20
AMI_TOKEN_SAFETY=1.15
# Experimental mechanisms remain opt-in; this profile does not embed gold annotations.

# --- Explicit updates (rc3 release profile: on; all three default to 0 in code) -----------
# When a user explicitly replaces or corrects a value, record it at Add (gpt-4o-mini, stage 1
# intent labelling + stage 2 extraction, run beside extraction), store the current-value
# sentence as an extra memory (RENDER), and at Search leave out the earlier, replaced items
# (WITHHOLD: a verifier over earlier memories and a question router; any failed call
# withholds nothing). Query only selects/withholds evidence. See README "Explicit updates".
# Set all three to 0 to behave as the 20261001 release.
AMI_UPDATE_DETECT=1
AMI_UPDATE_RENDER=1
AMI_UPDATE_WITHHOLD=1
AMI_UPDATE_VERSION=7

# --- Admission valve (0 = off) ------------------------------------------------------------
# At most N concurrent /add (/search); a request without a slot within AMI_ADMISSION_WAIT
# seconds is answered 429 + Retry-After before auth, any model call or write. Embedding
# rate limit -> 429, timeout/5xx -> 503 + Retry-After, before persistence. For the Full:
# Add valve 16, Search valve off, and start the platform job with Add 16 / Search 16.
AMI_ADD_MAX_INFLIGHT=16
AMI_SEARCH_MAX_INFLIGHT=0
AMI_ADMISSION_WAIT=45
AMI_RETRY_AFTER=10
# Request deadlines (rc4): every model and embedding call of an Add / Search must finish within
# this many seconds of its arrival (admission wait included), else 503 + Retry-After before
# anything is persisted. Keeps requests inside the ~100 s edge cut.
AMI_ADD_DEADLINE=85
AMI_SEARCH_DEADLINE=85
# 1: a failed extraction call fails the Add (429/503) instead of storing the turns without
# facts. A long provider outage then exhausts the platform's retry budget. Default 0.
AMI_EXTRACT_REQUIRED=0

# --- As-of evidence selection (rc4/rc5 release profile: on; default 0 in code) ------------
# For a question about a state at a stated date, returned items not valid at that date are
# withheld and refilled from the ranking. rc5: gpt-4o-mini classifies every Search question
# (beside the recall rewrite, cached; ~700 tokens) and, for an as-of state question, reads the
# times the candidates state (one call, cached per memory); code compares ISO dates.
# Membership only. Gates: bench/results/asof_selection_20261006.md (rc4),
# bench/results/rc5_language_neutral_20261006.md (rc5). See README "rc5", SUBMISSION (FAQ Q18).
AMI_ASOF_SELECT=1

# Optional diagnostic request log (JSON lines; evaluation data, off when empty).
# AMI_REQUEST_LOG=/data/requests.jsonl

# Other research mechanisms are disabled in the academic release.
AMI_DCI_SEARCH=0
AMI_DCI_FILL=0
AMI_AGENTIC_SEARCH=0
AMI_HOP2_SLOTS=0
AMI_FACT_EVIDENCE=0
AMI_FACT_SELECT=0
AMI_CHUNK_MEMORY=0
# Adaptive chunk delivery: not recommended (rc4: bench/results/adaptive_chunk_20261006.md;
# rc5 without its own cap: bench/results/adaptive_chunk_rc5_20261006.md, BEAM below baseline).
AMI_ADAPTIVE_CHUNK=0
AMI_EVENT_DATES=0
AMI_EVENT_DATES_AT_ADD=0
AMI_EVENT_DATES_STORED=0
AMI_EVENT_DATES_ADD_CALL=0
AMI_FACT_KEYS=0
AMI_SUPERSEDE_MARK=0
AMI_CHRONO_ORDER=0
AMI_NEWEST_FIRST=0
AMI_RERANK_MODEL=
