# --- required for a leaderboard run ------------------------------------------
# The competition requires gpt-4o-mini as the model used by Add and Search.
OPENAI_API_KEY=sk-...
AMI_LLM_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (used for local development only).
# OPENAI_BASE_URL=http://127.0.0.1:8001/v1

# --- retrieval knobs ---------------------------------------------------------
AMI_RECALL_WEIGHT=0.5        # weight of the user-voice recall question channel
AMI_RETURN_LIMIT=40          # we may return fewer than top_k; long contexts dilute the answer model
AMI_RETURN_CHAR_BUDGET=12000

# --- service -----------------------------------------------------------------
AMI_DB_PATH=/data/memory.sqlite3
AMI_EMBED_MODEL=BAAI/bge-small-en-v1.5
AMI_EMBED_DEVICE=cpu
AMI_AUTH_SCHEME=none         # none | bearer | token | x-api-key
# AMI_AUTH_TOKEN=change-me
