# ActiveMemoryIndex — environment configuration.
# Copy to .env, fill in the two REQUIRED values, then: docker compose up -d
#
#   cp .env.example .env
#
# Every variable has a production default. Only OPENAI_API_KEY and AMI_AUTH_TOKEN
# are required; everything below is optional and shown at its default.

# === REQUIRED ================================================================
# The competition requires gpt-4o-mini. This key must have access to it.
# Leave EMPTY to run without an LLM: the service still starts and serves the
# verbatim-text channel (degraded mode), and the full contract suite passes.
OPENAI_API_KEY=

# Memory System Key shared with the platform. Generate a strong random string:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The service REFUSES TO START if a scheme is set and this is empty or a
# placeholder — set AMI_AUTH_SCHEME=none instead for local testing.
AMI_AUTH_TOKEN=

# === MODEL ===================================================================
AMI_LLM_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (local development only).
# OPENAI_BASE_URL=http://127.0.0.1:8001/v1

# === AUTH =====================================================================
AMI_AUTH_SCHEME=bearer          # none | bearer | token | x-api-key
                                # none is for local smoke only; formal evals require auth.
                                # Any of the three schemes carrying the right secret is accepted.

# === HOST BINDING ============================================================
# AMI_BIND=127.0.0.1            # set to 0.0.0.0 to publish; do this only with a real token
# AMI_PORT=8000                 # host port
# AMI_CONTAINER=activememoryindex
# AMI_IMAGE=activememoryindex:latest
# AMI_VOLUME=ami-data           # rename these three to run a second copy on one host
# AMI_EDGE_NETWORK=vip-gateway_default
#                               # only read by docker-compose.edge.yml, the optional override that
#                               # publishes through an existing tunnel. Site-specific: set it to
#                               # your own external Docker network.

# === RETRIEVAL ===============================================================
AMI_RECALL_WEIGHT=0.5           # weight of the user-voice recall-question channel in fused score
AMI_RETURN_LIMIT=100            # max memories returned (never more than top_k). Measured, not
                                # assumed: end-to-end accuracy rises monotonically with this
                                # value on gpt-4o-mini (see bench/README.md).
AMI_RETURN_CHAR_BUDGET=400000   # character budget for one response. Must stay large enough not to
                                # silently truncate AMI_RETURN_LIMIT memories.
AMI_RAW_FIRST=1                 # order the returned set verbatim turns first, extracted facts
                                # second, each block keeping its relevance order. Changes the ORDER
                                # of the returned set, never its membership. This is the single
                                # largest lever measured: .5887 -> .6333 on LoCoMo (n=1540, paired
                                # p=4e-11), larger than every retrieval change tried. Set to 0 to
                                # return in pure relevance order. See README and
                                # bench/results/ordering_ab_all10.txt.
AMI_AGENTIC_SEARCH=0            # after retrieval, gpt-4o-mini reflects on gaps and may fire a
                                # second recall question. OFF by default: measured end-to-end at
                                # zero gain once the full top_k is returned (see README), while
                                # costing one extra LLM call per search. Set to 1 to enable.

# === EMBEDDING ===============================================================
AMI_EMBED_MODEL=BAAI/bge-small-en-v1.5
AMI_EMBED_DEVICE=cpu

# === STORAGE =================================================================
AMI_DB_PATH=/data/memory.sqlite3
AMI_CACHE_MAX_ITEMS=400000      # upper bound on rows held in the per-user vector cache, across all
                                # users. The cache is a read-through of SQLite, so eviction costs a
                                # reload, never a result. Without a bound, a dataset carrying one
                                # user_id per question grows the process until it is killed. 400k
                                # rows is ~0.6 GB of vectors; a LoCoMo-scale run (~10k rows) never
                                # reaches it. Lower it on a small host.

# === ADVANCED — rarely need to change ========================================
# AMI_LLM_CONCURRENCY=40        # cap on simultaneous provider calls (matches the server threadpool)
# AMI_LLM_TIMEOUT=25            # seconds per provider call
# AMI_LLM_RETRIES=1             # retries on transient failures
#                               # timeout x (retries+1) must stay under any proxy/CDN cut-off
# AMI_LLM_MAX_FACTS=24          # max extracted facts per Add chunk
# AMI_LLM_MAX_TOKENS_EXTRACT=1200
# AMI_LLM_MAX_TOKENS_QUERY=200
# AMI_EMBED_BATCH=64            # embedding batch size
# AMI_EXTRACT=1                 # set to 0 to disable fact extraction (raw-text only)
# AMI_RECALL_QUERY=1            # set to 0 to disable recall-question channel
# AMI_LLM_DISABLE_THINKING=0    # set to 1 when developing against local Qwen models
